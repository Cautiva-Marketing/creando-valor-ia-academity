# Copy to .env.local. Local values come from `pnpm supabase status` (research.md §R22).
# PUBLIC = exposed to the browser (NEXT_PUBLIC_*). SERVER = server-only, never NEXT_PUBLIC_*.
# Tests/e2e also load .env.test.local first (gitignored, same keys with local-stack values) so they
# never reach a remote project; tests/e2e/fixtures/env.ts refuses any non-local Supabase URL.

# --- PUBLIC ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Contact shown to users whose access is suspended (FR-024)
NEXT_PUBLIC_SUPPORT_EMAIL=soporte@ejemplo.pe
# Optional: Sentry DSN for the browser (DSNs are public by design)
NEXT_PUBLIC_SENTRY_DSN=

# --- SERVER ONLY ----------------------------------------------------------
# Supabase secret key (sb_secret_…): Auth Admin API, accept_invitation, rate limiting, audit
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Standard Webhooks secret of the Send Email Hook (v1,whsec_<base64>); same value as supabase/.env
SEND_EMAIL_HOOK_SECRET=v1,whsec_REPLACE_ME
# URI that Supabase Auth calls (local: Docker reaches the host via host.docker.internal)
SEND_EMAIL_HOOK_URI=http://host.docker.internal:3000/api/auth/send-email
# SMTP: Mailpit locally (127.0.0.1:54325, no auth); Resend SMTP in production
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Creando Valor IA <no-responder@ejemplo.pe>"
# Pepper for HMAC rate-limit keys and signed timestamps (>= 32 random bytes, base64)
RATE_LIMIT_PEPPER=REPLACE_ME
# Sentry (server)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- AI (002 research.md §R2; server only) ----------------------------------
# google = real providers per the AI_MODEL_* chains (Gemini and/or Groq); fake = deterministic test
# provider. Free tiers: ONLY fictitious data (Constitution II).
AI_PROVIDER=google
# Gemini API key (AI Studio). Free tier: 20 requests/day per model on gemini-3.6-flash.
GOOGLE_GENERATIVE_AI_API_KEY=
# Groq API key (console.groq.com, starts with gsk_). Free plan: ~1 000 requests/day per model.
GROQ_API_KEY=
# Model chain per task: "provider:model" entries tried in order on 429/5xx (failover without waiting);
# a bare id means google. Entries whose provider has no key are skipped; each task needs at least one.
# Groq cannot stream structured output: its buyer turns arrive in one piece. The Gemini buyer uses
# thinking level "minimal" (gemini-3.8-flash does not accept it). research.md §R4/§R16.
AI_MODEL_BUYER_SETUP=groq:openai/gpt-oss-120b,google:gemini-3.6-flash
AI_MODEL_BUYER=google:gemini-3.5-flash-lite,groq:openai/gpt-oss-120b
AI_MODEL_EVALUATOR=groq:openai/gpt-oss-120b,google:gemini-3.6-flash
# Bearer secret of the internal evaluation dispatcher (>= 32 random bytes). Locally it must match the
# value that supabase/seed.sql stores in Vault (practice_dispatch_secret); in production it is loaded
# with scripts/ops/set-practice-dispatch.ts.
PRACTICE_DISPATCH_SECRET=local-dev-practice-dispatch-secret-0000000000

# --- TESTS ONLY (rejected by src/lib/env.ts when NODE_ENV/VERCEL_ENV = production) ---
# Recipients of this domain make the SMTP send fail on purpose (e2e of "Reintentar envío")
E2E_EMAIL_FAIL_DOMAIN=
# Mailpit HTTP API used by Playwright fixtures
MAILPIT_URL=http://127.0.0.1:54324
