# Template for supabase/.env (env() substitutions in supabase/config.toml). Copy to supabase/.env.
SITE_URL=http://localhost:3000
SEND_EMAIL_HOOK_URI=http://host.docker.internal:3000/api/auth/send-email
# Same value as SEND_EMAIL_HOOK_SECRET in .env.local (format v1,whsec_<base64 32 bytes>)
SEND_EMAIL_HOOK_SECRET=v1,whsec_REPLACE_ME
